rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function for admin access
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'dofekrafael@gmail.com' || 
        request.auth.token.email == 'sjhonatan916@gmail.com' || 
        request.auth.token.email == 'contatodaysilmach@gmail.com' ||
        request.auth.token.email == 'contatoday@gmail.com' ||
        request.auth.token.email == 'floresceremadoracao@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^(dofekrafael@gmail\\.com|sjhonatan916@gmail\\.com|contatodaysilmach@gmail\\.com|contatoday@gmail\\.com|floresceremadoracao@gmail\\.com)$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /coin_history/{transactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /highlights/{highlightId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /devotionals/{devotionalId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bible_explanations/{explanationId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    match /user_progress/{progressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Handled by backend webhooks
    }

    match /store_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /store_products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /store_orders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        (resource.data.userEmail != null && request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isAuthenticated();
    }
  }
}

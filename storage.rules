rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pasta oficial de produtos da Loja Florescer
    match /store/products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Compatibilidade com uploads legados
    match /store_products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra geral para usuários autenticados
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
